---
interface Props {
	title: string;
	description?: string;
}
const { title, description = 'A daily tech reading digest.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={base}>Tech Reading Digest</a>
			<nav>
				<a href={base}>Latest</a>
				<a href={`${base}/archive/`}>Archive</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>
				Fetched, ranked, and summarized on a schedule —
				<a href="https://github.com/ShevinuM/daily-tech-digest">source</a>.
			</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--bg: #ffffff;
		--fg: #1a1a1a;
		--muted: #6b6b6b;
		--border: #e3e3e3;
		--accent: #2454ff;
		--card-bg: #f7f7f8;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0f1115;
			--fg: #eaeaea;
			--muted: #9a9a9a;
			--border: #2a2d34;
			--accent: #6c9bff;
			--card-bg: #171a20;
		}
	}
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		background: var(--bg);
		color: var(--fg);
		font-family:
			-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		line-height: 1.55;
	}
	a {
		color: var(--accent);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 760px;
		margin: 0 auto;
		padding: 1.5rem 1.25rem 1rem;
		border-bottom: 1px solid var(--border);
	}
	.brand {
		font-weight: 700;
		color: var(--fg);
	}
	.site-header nav {
		display: flex;
		gap: 1.25rem;
	}
	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 1.5rem 1.25rem 3rem;
	}
	.site-footer {
		max-width: 760px;
		margin: 0 auto;
		padding: 1.5rem 1.25rem 3rem;
		color: var(--muted);
		font-size: 0.85rem;
		border-top: 1px solid var(--border);
	}
	h1 {
		font-size: 1.7rem;
		margin-bottom: 0.25rem;
	}
	.intro {
		color: var(--muted);
		font-style: italic;
		margin-top: 0;
	}
	.meta {
		color: var(--muted);
		font-size: 0.85rem;
	}
	section.digest-section {
		margin-top: 2rem;
	}
	section.digest-section h2 {
		font-size: 1.25rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.4rem;
	}
	article.item {
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1rem 1.1rem;
		margin: 1rem 0;
	}
	article.item h3 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
	}
	article.item .item-meta {
		color: var(--muted);
		font-size: 0.8rem;
		margin-bottom: 0.5rem;
	}
	article.item .tags {
		margin-top: 0.6rem;
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	article.item .tag {
		font-size: 0.72rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.1rem 0.55rem;
	}
	.archive-list {
		list-style: none;
		padding: 0;
	}
	.archive-list li {
		border-bottom: 1px solid var(--border);
		padding: 0.85rem 0;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}
	.empty-state {
		color: var(--muted);
		border: 1px dashed var(--border);
		border-radius: 10px;
		padding: 2rem;
		text-align: center;
	}
</style>
