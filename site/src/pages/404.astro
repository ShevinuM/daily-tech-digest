---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/withBase';
---

<Layout title="Page Not Found">
	<Header />
	<main
		id="main-content"
		class="app-layout flex flex-1 flex-col items-center justify-center py-16 text-center"
	>
		<h1 class="text-4xl font-bold sm:text-5xl">404</h1>
		<p class="mt-4 text-lg">The page you're looking for doesn't exist.</p>
		<a
			href={withBase('/')}
			class="text-accent mt-6 inline-block underline decoration-dashed underline-offset-4 hover:no-underline focus-visible:no-underline"
		>
			Go back home
		</a>
	</main>
	<Footer />
</Layout>
