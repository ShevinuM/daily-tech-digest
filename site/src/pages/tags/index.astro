---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Main from '../../components/Main.astro';
import { getUniqueTags } from '../../utils/getUniqueTags';
import { withBase } from '../../utils/withBase';

const tags = await getUniqueTags();
---

<Layout title="Tags">
	<Header />
	<Main pageTitle="Tags" pageDesc="Browse every digest item by tag.">
		<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
			{
				tags.map(({ tag, tagName, count }) => (
					<li>
						<a
							href={withBase(`/tags/${tag}/`)}
							class="border-foreground hover:border-accent hover:text-accent focus-visible:text-accent inline-flex items-baseline gap-1.5 border-b-2 border-dashed text-lg focus-visible:border-none"
						>
							#{tagName}
							<span class="text-muted-foreground text-sm">({count})</span>
						</a>
					</li>
				))
			}
		</ul>
	</Main>
	<Footer />
</Layout>
