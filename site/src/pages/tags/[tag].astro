---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Main from '../../components/Main.astro';
import Tag from '../../components/Tag.astro';
import Datetime from '../../components/Datetime.astro';
import { getUniqueTags } from '../../utils/getUniqueTags';
import { getItemsByTag } from '../../utils/getItemsByTag';
import { slugifyStr } from '../../utils/slugify';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	const tags = await getUniqueTags();
	return tags.map(({ tag, tagName }) => ({
		params: { tag },
		props: { tagName },
	}));
}

const { tag } = Astro.params;
const { tagName } = Astro.props;
const groups = await getItemsByTag(tag as string);
const totalItems = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<Layout title={`#${tagName}`}>
	<Header />
	<Main
		pageTitle={`#${tagName}`}
		pageDesc={`${totalItems} item${totalItems === 1 ? '' : 's'} tagged #${tagName}, across ${groups.length} digest${groups.length === 1 ? '' : 's'}.`}
	>
		{
			groups.map((group) => (
				<section class="mt-8">
					<h2 class="border-border border-b pb-2 text-xl font-semibold">
						<a
							href={withBase(`/digest/${group.date}/`)}
							class="hover:underline focus-visible:no-underline"
						>
							{group.title}
						</a>
					</h2>
					<ul class="mt-4 space-y-6">
						{group.items.map((item) => (
							<li>
								<article class="border-border rounded-lg border p-4">
									<h3 class="text-lg font-medium">
										<a
											href={item.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-accent hover:underline"
										>
											{item.title}
										</a>
									</h3>
									<p class="text-muted-foreground mt-1 flex flex-wrap items-center gap-x-2 text-sm">
										<span>{item.source}</span>
										<span>&middot;</span>
										<Datetime dateStr={item.publishedAt} />
									</p>
									<p class="mt-2">{item.summary}</p>
									{item.tags.length > 0 && (
										<ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
											{item.tags.map((itemTagName) => (
												<Tag tag={slugifyStr(itemTagName)} tagName={itemTagName} size="sm" />
											))}
										</ul>
									)}
								</article>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</Main>
	<Footer />
</Layout>
