---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DigestBody from '../components/DigestBody.astro';

const digests = await getCollection('digests');
const latest = digests.sort((a, b) => b.id.localeCompare(a.id))[0];
// Strip a trailing slash — BASE_URL is "/" at the custom-domain root, and
// "//path" is a protocol-relative URL, not a same-site path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={latest ? latest.data.title : 'Tech Reading Digest'}>
	{
		latest ? (
			<DigestBody
				title={latest.data.title}
				intro={latest.data.intro}
				sections={latest.data.sections}
				stats={latest.data.stats}
			/>
		) : (
			<div class="empty-state">
				<p>No digest published yet — check back after the next scheduled run.</p>
			</div>
		)
	}
	{
		digests.length > 1 && (
			<p class="meta">
				<a href={`${base}/archive/`}>See all {digests.length} past digests →</a>
			</p>
		)
	}
</Layout>
