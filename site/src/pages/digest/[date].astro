---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DigestSections from '../../components/DigestSections.astro';
import Datetime from '../../components/Datetime.astro';
import { getSortedDigests } from '../../utils/getSortedDigests';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	const digests = await getSortedDigests();
	// `digests` is newest-first, so the entry immediately after this one in
	// the array is older ("prev") and the one immediately before is newer ("next").
	return digests.map((entry, index) => ({
		params: { date: entry.id },
		props: {
			entry,
			prevDigest: digests[index + 1] ?? null,
			nextDigest: index > 0 ? digests[index - 1] : null,
		},
	}));
}

const { entry, prevDigest, nextDigest } = Astro.props;
---

<Layout title={entry.data.title}>
	<Header />
	<main id="main-content" class="app-layout pb-4">
		<a
			href={withBase('/archive/')}
			class="hover:text-accent focus-visible:no-underline mb-6 inline-flex items-center gap-1"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M19 12H5M12 19l-7-7 7-7" />
			</svg>
			Back to archive
		</a>
		<article>
			<h1 class="text-2xl font-semibold sm:text-3xl">{entry.data.title}</h1>
			<div class="text-muted-foreground mt-2 flex flex-wrap items-center gap-x-2">
				<Datetime dateStr={entry.data.generatedAt} />
				<span>&middot;</span>
				<span>
					{entry.data.stats.itemCount} item{entry.data.stats.itemCount === 1 ? '' : 's'}
				</span>
			</div>
			{entry.data.intro && <p class="mt-4 italic">{entry.data.intro}</p>}
			<DigestSections sections={entry.data.sections} />
			{
				entry.data.stats.errors.length > 0 && (
					<p class="text-muted-foreground mt-4 text-sm">
						{entry.data.stats.errors.length} source error(s) this run — see the run's GitHub
						Actions log for detail.
					</p>
				)
			}
		</article>

		<nav
			class="border-border mt-12 flex items-center justify-between gap-4 border-t pt-6"
			aria-label="Digest navigation"
		>
			{
				prevDigest ? (
					<a
						href={withBase(`/digest/${prevDigest.id}/`)}
						class="text-accent hover:underline focus-visible:no-underline"
					>
						&larr; Older digest
					</a>
				) : (
					<span />
				)
			}
			{
				nextDigest ? (
					<a
						href={withBase(`/digest/${nextDigest.id}/`)}
						class="text-accent hover:underline focus-visible:no-underline"
					>
						Newer digest &rarr;
					</a>
				) : (
					<span />
				)
			}
		</nav>
	</main>
	<Footer />
</Layout>
